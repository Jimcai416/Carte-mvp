{
  "expo": {
    "name": "Tavue",
    "slug": "dishlens",
    "version": "0.8.2",
    "orientation": "portrait",
    "icon": "./assets/tavue-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/tavue-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF4E5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.playbook.dishlens",
      "infoPlist": {
        "NSCameraUsageDescription": "Tavue uses the camera to scan restaurant menus.",
        "NSPhotoLibraryUsageDescription": "Tavue lets you choose a menu photo from your library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.playbook.dishlens",
      "adaptiveIcon": {
        "foregroundImage": "./assets/tavue-adaptive-foreground.png",
        "monochromeImage": "./assets/tavue-adaptive-monochrome.png",
        "backgroundColor": "#FFF4E5"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/tavue-favicon.png",
      "name": "Tavue — Visual Menu",
      "shortName": "Tavue",
      "themeColor": "#F7F3EE",
      "backgroundColor": "#F7F3EE"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Tavue uses the camera to scan restaurant menus.",
          "microphonePermission": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "carte-lab"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "859efdc3-4c16-448c-9e6a-fe98349513c5"
      }
    }
  }
}
