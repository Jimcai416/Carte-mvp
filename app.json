{
  "expo": {
    "name": "Carte",
    "slug": "dishlens",
    "version": "0.5.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F7F3EA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.playbook.dishlens",
      "infoPlist": {
        "NSCameraUsageDescription": "Carte uses the camera to scan restaurant menus.",
        "NSPhotoLibraryUsageDescription": "Carte lets you choose a menu photo from your library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.playbook.dishlens",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Carte uses the camera to scan restaurant menus."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "859efdc3-4c16-448c-9e6a-fe98349513c5"
      }
    }
  }
}
